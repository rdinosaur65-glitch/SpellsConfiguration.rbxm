# Copy to apps/web/.env.local. See docs/ENVIRONMENT.md. Public values only — never put
# the service-role key or VAPID private key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key (free). Set it when bot protection is on in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Optional: how people can reach the owner (shown on the privacy page), e.g. an email address.
VITE_OWNER_CONTACT=
VITE_VAPID_PUBLIC_KEY=
VITE_TURN_CREDENTIALS_URL=
VITE_STUN_URLS=stun:stun.l.google.com:19302
